# 数据库路径（SQLite）
DATABASE_URL=sqlite:./moefarm.db

# 服务端口
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# JWT 密钥（生产环境请替换为强随机字符串）
JWT_SECRET=change-this-to-a-random-secret-key

# 微信小程序 AppID 和 AppSecret（微信后台获取）
WX_APP_ID=your-wechat-app-id
WX_APP_SECRET=your-wechat-app-secret

# 静态资源目录（相对于 Server 根目录）
STATIC_DIR=./assets

# 日志级别
RUST_LOG=moefarm_server=info,tower_http=info
