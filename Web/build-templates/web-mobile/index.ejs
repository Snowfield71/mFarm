<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Cocos Creator | <%= projectName %></title>
  <meta name="viewport" content="width=device-width,user-scalable=no,initial-scale=1,minimum-scale=1,maximum-scale=1,minimal-ui=true"/>
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="format-detection" content="telephone=no">
  <meta name="renderer" content="webkit"/>
  <meta name="force-rendering" content="webkit"/>
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1"/>
  <meta name="msapplication-tap-highlight" content="no">
  <meta name="full-screen" content="yes"/>
  <meta name="x5-fullscreen" content="true"/>
  <meta name="360-fullscreen" content="true"/>
  <meta name="x5-page-mode" content="app">
  <link rel="preload" as="image" href="startup-loading.png" fetchpriority="high">
  <link rel="stylesheet" type="text/css" href="<%= cssUrl %>"/>
</head>
<body>
  <div id="GameDiv" cc_exact_fit_screen="true">
    <img id="StartupLoadingArtwork" src="startup-loading.png" alt="" fetchpriority="high" decoding="sync" draggable="false">
    <div id="Cocos3dGameContainer">
      <canvas id="GameCanvas" oncontextmenu="event.preventDefault()" tabindex="99"></canvas>
    </div>
  </div>
  <script>
    window.__removeMoefarmStartupArtwork = function () {
      var image = document.getElementById('StartupLoadingArtwork');
      if (!image || image.dataset.removing === 'true') return;
      image.dataset.removing = 'true';
      image.classList.add('startup-loading-hidden');
      window.setTimeout(function () {
        if (image.parentNode) image.parentNode.removeChild(image);
      }, 180);
    };
  </script>
  <%- include(cocosTemplate, {}) %>
</body>
</html>
